# Copy to `.env` (git-ignored) and fill in. Every setting in
# src/logjam/config.py can be overridden with a LOGJAM_-prefixed var.

# --- AISStream.io (live AIS) -------------------------------------------------
# Free API key: register at https://aisstream.io, create a key, paste it here.
# Without it, `logjam ais-collect` exits with an error; everything else works.
LOGJAM_AISSTREAM_API_KEY=

# Optional overrides:
# LOGJAM_AIS_SAMPLE_MINUTES=30
# LOGJAM_DB_PATH=data/logjam.duckdb
# LOGJAM_INITIAL_BACKFILL_DAYS=900
